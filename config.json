{
  "safe_below_c": 70,
  "hot_at_c": 80,
  "critical_at_c": 90,
  "hysteresis_c": 5,
  "monitor_interval_seconds": 5,
  "action_cooldown_seconds": 15,
  "browser_cpu_percent": 20,
  "browser_ram_mb": 1024,
  "whitelist": ["Code.exe", "python.exe", "pythonw.exe", "jupyter.exe", "Docker Desktop.exe"],
  "protected": ["explorer.exe", "svchost.exe", "winlogon.exe", "csrss.exe", "dwm.exe", "services.exe", "lsass.exe", "smss.exe", "system", "registry", "securityhealthservice.exe", "msmpeng.exe"],
  "browsers": ["chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe"],
  "background_apps": ["steam.exe", "epicgameslauncher.exe", "onedrive.exe", "discord.exe", "teams.exe"],
  "dry_run": true,
  "auto_actions_paused": false,
  "mute": false,
  "do_not_disturb": false,
  "voice_backend": "windows",
  "voice_activation": true,
  "show_overlay": true,
  "pet_always_visible": true,
  "allow_critical_hibernate": false,
  "lhm_url": "http://localhost:8085/data.json"
